# Provider: gemini (default) or openai
LLM_PROVIDER=gemini

# Gemini (get a key at https://aistudio.google.com/apikey)
GOOGLE_API_KEY=your_gemini_api_key
# OpenAI (only needed if LLM_PROVIDER=openai)
OPENAI_API_KEY=

PINECONE_API_KEY=your_pinecone_api_key
PINECONE_INDEX_NAME=agentic-ai-index

# ---- Optional tuning ----
# GEMINI_LLM_MODEL=gemini-flash-latest
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
TOP_K=4
# Minimum cosine similarity for a chunk to count as "relevant". Below this for
# ALL chunks -> refuse without calling the LLM. Find yours with: python -m src.calibrate
# (defaults: 0.55 for gemini, 0.30 for openai)
# RELEVANCE_THRESHOLD=0.55
# Free-tier friendly ingestion
# EMBED_BATCH_SIZE=50
# EMBED_BATCH_PAUSE=1.0
